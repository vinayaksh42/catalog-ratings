# --- Required -------------------------------------------------------------
# TMDB supplies the catalogs (which titles are on which platform, per region).
# Get a key at https://www.themoviedb.org/settings/api
# Use either the v3 API key or the v4 "API Read Access Token" (one is enough).
TMDB_API_KEY=
TMDB_READ_TOKEN=

# --- Optional -------------------------------------------------------------
# Rotten Tomatoes (Tomatometer) and Metacritic scores, via OMDb. Off by default.
# Set ROTTEN_TOMATOES=true and add OMDB_API_KEY to collect them and show them on the dashboard.
ROTTEN_TOMATOES=false
# Get a key at https://www.omdbapi.com/apikey.aspx  (free tier = 1,000 calls/day)
OMDB_API_KEY=
OMDB_DAILY_LIMIT=1000
# Re-check a title's Rotten Tomatoes score once it's older than this many days
RT_REFRESH_DAYS=30

# Two-letter country code. Catalogs differ by country.
REGION=CA

# Titles with fewer IMDb votes than this are left out of the statistics
MIN_VOTES=100
# Stricter floor for the top/bottom lists and "biggest movers"
LIST_MIN_VOTES=1000

# Cap pages per catalog query (20 titles per page). 0 = no cap.
# Set to 3 for a quick test run before doing a full one.
MAX_PAGES=0
WORKERS=8

# --- For putting it online ------------------------------------------------
# When set, starting a run requires this token (the dashboard will ask for it)
ADMIN_TOKEN=
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
# Where the SQLite database and IMDb download are kept (default: backend/data)
DATA_DIR=
